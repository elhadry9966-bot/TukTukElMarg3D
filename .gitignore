# This is a .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emps/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get large and so are ignored by default
/[Mm]emoryCaptures/

# AssetServer cache directory
/[Aa]ssetServerCache/

# Autogenerated VS/MonoDevelop/JetBrains Rider files
/*.csproj
/*.sln
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Xcode
.DS_Store
*.xcodeproj
/*.xcworkspace

# IL2CPP C++ intermediate build output
/[Cc][Aa][Cc][Hh][Ee]ísimo/
/[Bb]uild[Oo]utput/